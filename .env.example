# ---------------------------------------------------------------- Stark Bank
STARKBANK_ENVIRONMENT=sandbox
STARKBANK_PROJECT_ID=your_project_id_here

# Supply the private key by ONE of the two options below.
#
# Local development: point at the PEM file produced by scripts/generate_keys.py
STARKBANK_PRIVATE_KEY_PATH=keys/private-key.pem
#
# Deployment: paste the PEM content with escaped newlines instead
# STARKBANK_PRIVATE_KEY="-----BEGIN EC PARAMETERS-----\nBgUrgQQACg==\n-----END EC PARAMETERS-----\n-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"

# ---------------------------------------------------------------- Storage
DATABASE_URL=sqlite:///./data/app.db

# ---------------------------------------------------------------- Issuer
ISSUER_ENABLED=true
ISSUER_INTERVAL_HOURS=3
ISSUER_TOTAL_BATCHES=8
ISSUER_MIN_INVOICES=8
ISSUER_MAX_INVOICES=12
ISSUER_MIN_AMOUNT=1000
ISSUER_MAX_AMOUNT=100000
ISSUER_EXPIRATION_SECONDS=86400

# ---------------------------------------------------------------- Reconciliation
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_MINUTES=15

# ---------------------------------------------------------------- Destination
# Defaults already match the challenge statement. Override only if needed.
TRANSFER_BANK_CODE=20018183
TRANSFER_BRANCH_CODE=0001
TRANSFER_ACCOUNT_NUMBER=6341320293482496
TRANSFER_ACCOUNT_TYPE=payment
TRANSFER_NAME=Stark Bank S.A.
TRANSFER_TAX_ID=20.018.183/0001-80

# ---------------------------------------------------------------- Misc
LOG_LEVEL=INFO
